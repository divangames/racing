{
  "id": "09",
  "name": "САЙБОРГ ДЖО",
  "role": "npc",
  "voice": "Плоский, металлический, почти без эмоций. Мат как код ошибки: коротко, холодно, без крика. Паузы как перезагрузка. Оптика щелкает.",
  "cues": [
    {
      "id": "name",
      "event": "Представление NPC",
      "takes": [
        { "file": "name_01.mp3", "text": "Джо. Сайборг. Эмоций нет, пиздец есть." },
        { "file": "name_02.mp3", "text": "Половина лица — хром. Вторая тоже не улыбается." },
        { "file": "name_03.mp3", "text": "Это Джо. Оптика включена. Ты уже цель." }
      ]
    },
    {
      "id": "start",
      "event": "Старт гонки",
      "takes": [
        { "file": "start_01.mp3", "text": "Старт. Тормоза удалены. Как и совесть." },
        { "file": "start_02.mp3", "text": "Траектория посчитана. Вы — погрешность, блядь." },
        { "file": "start_03.mp3", "text": "Зелёный. Органика, не мешайте железу." }
      ]
    },
    {
      "id": "lead",
      "event": "Вышел в лидеры",
      "takes": [
        { "file": "lead_01.mp3", "text": "Первый. Логично. Вы тормозите чувствами." },
        { "file": "lead_02.mp3", "text": "Лидерство подтверждено. Остальные — мусор данных." },
        { "file": "lead_03.mp3", "text": "Впереди. Сзади шум. Игнорирую, сука." }
      ]
    },
    {
      "id": "chase",
      "event": "Догоняет соперника",
      "takes": [
        { "file": "chase_01.mp3", "text": "Догоняю. Вероятность твоего пиздеца: сто." },
        { "file": "chase_02.mp3", "text": "Цель захвачена. Не дёргайся — бесполезно." },
        { "file": "chase_03.mp3", "text": "Сзади хром. Спереди — твоя ошибка." }
      ]
    },
    {
      "id": "ram",
      "event": "Таран",
      "takes": [
        { "file": "ram_01.mp3", "text": "Контакт. Корпус смят. Как планировалось." },
        { "file": "ram_02.mp3", "text": "Таран. Органика хрупкая, блядь." },
        { "file": "ram_03.mp3", "text": "Кушай хром. Зубы не предусмотрены." }
      ]
    },
    {
      "id": "hit",
      "event": "Получил удар",
      "takes": [
        { "file": "hit_01.mp3", "text": "Урон. Косметика. Характер в ПЗУ." },
        { "file": "hit_02.mp3", "text": "Попал. Зафиксировал. Сейчас удалю." },
        { "file": "hit_03.mp3", "text": "Царапина. Железо злится тише людей, сука." }
      ]
    },
    {
      "id": "nitro",
      "event": "Нитро",
      "takes": [
        { "file": "nitro_01.mp3", "text": "Нитро. Разгон вне допуска. Плевать." },
        { "file": "nitro_02.mp3", "text": "Ускорение. Законы физики — нахуй." },
        { "file": "nitro_03.mp3", "text": "Сейчас будет короткое замыкание в твоей башке." }
      ]
    },
    {
      "id": "kill",
      "event": "Уничтожил соперника",
      "takes": [
        { "file": "kill_01.mp3", "text": "Цель удалена. Даже лог не пишу." },
        { "file": "kill_02.mp3", "text": "Минус. Органика вышла из строя. Типично." },
        { "file": "kill_03.mp3", "text": "Спи. Ты был багом, не гонщиком." }
      ]
    },
    {
      "id": "last_lap",
      "event": "Последний круг",
      "takes": [
        { "file": "last_lap_01.mp3", "text": "Последний круг. Расчёт: вы умрёте." },
        { "file": "last_lap_02.mp3", "text": "Финиш. Отклонение не допускается, блядь." },
        { "file": "last_lap_03.mp3", "text": "Дожимаю. Эмоции отключены. Газ — нет." }
      ]
    },
    {
      "id": "win",
      "event": "Победа",
      "takes": [
        { "file": "win_01.mp3", "text": "Победа. Ожидаемо. Аплодисменты не нужны." },
        { "file": "win_02.mp3", "text": "Кубок. Металл к металлу. Вы — шлак." },
        { "file": "win_03.mp3", "text": "Выиграл. Система стабильна. Вы — нет, сука." }
      ]
    },
    {
      "id": "lose",
      "event": "Проигрыш",
      "takes": [
        { "file": "lose_01.mp3", "text": "Поражение. Пересчёт. Потом всех нахуй." },
        { "file": "lose_02.mp3", "text": "Ошибка. Чиню. Органика ещё пожалеет." },
        { "file": "lose_03.mp3", "text": "Гараж. Прошивка злости. Версия: пиздец." }
      ]
    },
    {
      "id": "taunt",
      "event": "Подкол по рации",
      "takes": [
        { "file": "taunt_01.mp3", "text": "Едешь как сбой. Рекомендую кладбище." },
        { "file": "taunt_02.mp3", "text": "У тебя пульс. Это слабость, дебил." },
        { "file": "taunt_03.mp3", "text": "Не тормози мозгом. Его у тебя нет, блядь." }
      ]
    }
  ]
}
