{
  "name": "kolesnica-voyny",
  "version": "0.2.2-13",
  "description": "Лаунчер Колесницы войны. Игру он сам потом докачает.",
  "main": "src/main/boot.js",
  "author": "Divan Games",
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "test": "node --test tests/*.test.cjs",
    "test:engine": "electron tools/smoke-engine.cjs",
    "test:car-lights": "electron tools/check-car-lights.cjs",
    "test:combat-feel": "electron tools/check-combat-feel.cjs",
    "test:race-upgrade": "electron tools/check-race-upgrade.cjs",
    "test:menus": "electron tools/check-menu-design.cjs",
    "test:audio-balance": "electron tools/check-audio-balance.cjs",
    "test:track-tactics": "electron tools/check-track-tactics.cjs",
    "test:editor-draft": "electron tools/check-draft-test.cjs",
    "test:audio": "electron tools/check-ambient-audio.cjs",
    "postinstall": "node tools/prepare-content.cjs && node tools/copy-vendor.cjs && node tools/sync-launcher-media.cjs",
    "content:prepare": "node tools/prepare-content.cjs",
    "start": "node tools/prepare-content.cjs && electron .",
    "start:lab": "node tools/prepare-content.cjs && electron . --lab",
    "start:editor": "node tools/prepare-content.cjs && electron . --lab",
    "start:game": "node tools/prepare-content.cjs && electron . --game",
    "manifest": "node tools/build-manifest.cjs",
    "sync": "node tools/sync-content.cjs",
    "icon": "python tools/make-icon.py",
    "cert": "powershell -NoProfile -ExecutionPolicy Bypass -File tools/ensure-code-cert.ps1",
    "art:msi": "python tools/make-installer-art.py && node tools/sync-installer-art.cjs",
    "media": "node tools/sync-launcher-media.cjs",
    "pack": "npm run media && node tools/build-with-safe-path.cjs npx --no-install electron-builder --win dir",
    "portable": "node tools/make-portable.cjs",
    "pack:game": "node tools/pack-game-release.cjs",
    "publish:launcher": "node tools/publish-launcher-release.cjs",
    "prefetch:wix": "node tools/prefetch-builder-binaries.cjs",
    "dist": "npm run media && node tools/build-with-safe-path.cjs npx --no-install electron-builder --win nsis",
    "dist:msi": "npm run prefetch:wix && npm run media && npm run art:msi && node tools/build-with-safe-path.cjs npx --no-install electron-builder --win msi --config.directories.output=out-msi"
  },
  "dependencies": {
    "quarks.core": "0.16.0"
  },
  "devDependencies": {
    "electron": "^37.3.1",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "com.divangames.kolesnicavoyny",
    "productName": "Колесница войны",
    "copyright": "Divan Games",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "forceCodeSigning": true,
    "afterPack": "tools/after-pack.cjs",
    "msiProjectCreated": "tools/msi-project-created.cjs",
    "files": [
      "src/**/*",
      "config/**/*",
      "package.json"
    ],
    "asarUnpack": [
      "src/launcher/media/**"
    ],
    "extraResources": [
      {
        "from": "CHANGELOG.md",
        "to": "CHANGELOG.md"
      },
      {
        "from": "manifest",
        "to": "manifest"
      },
      {
        "from": "vendor-local",
        "to": "vendor-local"
      }
    ],
    "win": {
      "icon": "build/icon.ico",
      "executableName": "KolesnicaVoyny",
      "artifactName": "KolesnicaVoyny-${env.KOLESNICA_VERSION}.${ext}",
      "signtoolOptions": {
        "sign": "./tools/sign-windows.cjs",
        "certificateFile": "certs/divan-games.pfx",
        "publisherName": "Divan Games",
        "signingHashAlgorithms": [
          "sha256"
        ],
        "rfc3161TimeStampServer": null,
        "timeStampServer": null
      },
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "msi": {
      "oneClick": false,
      "perMachine": true,
      "runAfterFinish": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Колесница Войны",
      "menuCategory": "Divan Games",
      "upgradeCode": "8F3A2C10-9B47-4E21-9C6A-7D1E5B2A4F80",
      "additionalLightArgs": [
        "-loc",
        "ui-ru.wxl"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Колесница войны",
      "installerLanguages": [
        "ru_RU"
      ],
      "language": "1049"
    }
  }
}
